int identity(int value) {
  return value;
}

int dot3(int a, int b, int c, int x, int y, int z) {
  return a * x + b * y + c * z;
}

int main() {
  int seed = identity(1);
  int row0 = dot3(seed, 2, 3, 7, 8, 9);
  int row1 = dot3(4, 5, 6, 7, 8, 9);
  int row2 = dot3(7, 8, 9, 7, 8, 9);
  return row0 + row1 + row2;
}
